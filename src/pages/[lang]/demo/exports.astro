                    <div class="export-email-mailbox-list">
                      <div class="export-email-mailbox-item active">
                        <div class="export-email-skeleton medium"></div>
                        <div class="export-email-skeleton short"></div>
                      </div>
                      <div class="export-email-mailbox-item faded">
                        <div class="export-email-skeleton medium"></div>
                        <div class="export-email-skeleton short"></div>
                      </div>
                      <div class="export-email-mailbox-item faded">
                        <div class="export-email-skeleton medium"></div>
                        <div class="export-email-skeleton short"></div>
                      </div>
                    </div>
                  </div>
                  <div class="export-email-content">
                    <div class="export-email-header">
                      <div class="export-email-header-row">
                        <span class="export-email-header-label">{et.mockTo}</span>
                        <span class="export-email-header-recipient">{et.mockRecipient}</span>
                      </div>
                      <div class="export-email-header-row">
                        <span class="export-email-header-label">{et.mockSubject}</span>
                        <span>Customer Export — 3 records</span>
                      </div>
                    </div>
                    <div class="export-email-iframe-wrap">
                      <div style="padding:1rem;background:white;height:100%;overflow:auto">
                        <table class="export-preview-table">
                          <thead><tr><th>{et.tableHeaderName}</th><th>{et.tableHeaderEmail}</th><th>{et.tableHeaderStatus}</th></tr></thead>
                          <tbody>
                            <tr><td>Acme Corp</td><td>info@acme.com</td><td>{et.statusActive}</td></tr>
                            <tr><td>Globex Inc</td><td>hello@globex.com</td><td>{et.statusActive}</td></tr>
                            <tr><td>Initech</td><td>contact@initech.com</td><td>{et.statusLead}</td></tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Footer (mode-specific buttons, cross-faded by scroll script) -->
            <div class="export-preview-footer">
              <button class="mp-btn-secondary-outline">{et.mockClose}</button>
              <div id="preview-footer-html" class="preview-footer-btn" style="opacity:1">
                <button class="mp-btn-primary">{et.mockCopyHtml}</button>
              </div>
              <div id="preview-footer-pdf" class="preview-footer-btn" style="opacity:0">
                <button class="mp-btn-primary">{et.mockDownloadPdf}</button>
              </div>
              <div id="preview-footer-email" class="preview-footer-btn" style="opacity:0">
                <button class="mp-btn-primary">{et.mockCopyEmailHtml}</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== Annotation cards ===== -->
      <div class="ann-label" id="ann-export-buttons"><div class="ann-card"><div class="ann-title">{et.annExportButtonsTitle}</div><div class="ann-desc">{et.annExportButtonsDesc}</div></div></div>
      <div class="ann-label" id="ann-export-dialog"><div class="ann-card"><div class="ann-title">{et.annExportDialogTitle}</div><div class="ann-desc">{et.annExportDialogDesc}</div></div></div>
      <div class="ann-label" id="ann-export-choicebox"><div class="ann-card"><div class="ann-title">{et.annExportChoiceboxTitle}</div><div class="ann-desc">{et.annExportChoiceboxDesc}</div></div></div>
      <div class="ann-label" id="ann-export-choicebox-rbac"><div class="ann-card"><div class="ann-title">{et.annExportChoiceboxRbacTitle}</div><div class="ann-desc">{et.annExportChoiceboxRbacDesc}</div></div></div>
      <div class="ann-label" id="ann-export-cta-real"><div class="ann-card"><div class="ann-title">{et.annExportCtaRealTitle}</div><div class="ann-desc">{et.annExportCtaRealDesc}</div></div></div>
      <div class="ann-label" id="ann-html-dialog"><div class="ann-card"><div class="ann-title">{et.annHtmlDialogTitle}</div><div class="ann-desc">{et.annHtmlDialogDesc}</div></div></div>
      <div class="ann-label" id="ann-preview-html"><div class="ann-card"><div class="ann-title">{et.annPreviewHtmlTitle}</div><div class="ann-desc">{et.annPreviewHtmlDesc}</div></div></div>
      <div class="ann-label" id="ann-preview-pdf"><div class="ann-card"><div class="ann-title">{et.annPreviewPdfTitle}</div><div class="ann-desc">{et.annPreviewPdfDesc}</div></div></div>
      <div class="ann-label" id="ann-preview-email"><div class="ann-card"><div class="ann-title">{et.annPreviewEmailTitle}</div><div class="ann-desc">{et.annPreviewEmailDesc}</div></div></div>

      <!-- ===== SVG connectors ===== -->
      <svg class="connector-svg" id="connectors">
        <line class="conn-line" id="line-export-buttons" /><circle class="conn-dot" id="dot-export-buttons" r="4" />
        <line class="conn-line" id="line-export-choicebox-rbac" /><circle class="conn-dot" id="dot-export-choicebox-rbac" r="4" />
        <line class="conn-line" id="line-export-cta-real" /><circle class="conn-dot" id="dot-export-cta-real" r="4" />
        <line class="conn-line" id="line-export-dialog" /><circle class="conn-dot" id="dot-export-dialog" r="4" />
        <line class="conn-line" id="line-export-choicebox" /><circle class="conn-dot" id="dot-export-choicebox" r="4" />
        <line class="conn-line" id="line-html-dialog" /><circle class="conn-dot" id="dot-html-dialog" r="4" />
        <line class="conn-line" id="line-html-dialog-cta" /><circle class="conn-dot" id="dot-html-dialog-cta" r="4" />
        <line class="conn-line" id="line-preview-html" /><circle class="conn-dot" id="dot-preview-html" r="4" />
        <line class="conn-line" id="line-preview-pdf" /><circle class="conn-dot" id="dot-preview-pdf" r="4" />
        <line class="conn-line" id="line-preview-email" /><circle class="conn-dot" id="dot-preview-email" r="4" />
      </svg>

    </div>
  </div>
</div>

<!-- ===== Inline SVG icons not in icons.js ===== -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .7 10.823 10.823 0 0 1-1.355 2.282m-3.858 1.859A10.77 10.77 0 0 1 12 17.546a10.77 10.77 0 0 1-7.5-3.046m-2.7-2.54A10.823 10.823 0 0 1 1.062 12.65a1 1 0 0 1 0-.7 10.744 10.744 0 0 1 4.335-5.187M2 2l20 20M9.88 9.88a3 3 0 1 0 4.24 4.24"/></symbol>
    <symbol id="i-more-vertical" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></symbol>
    <symbol id="i-panel-right-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/></symbol>
    <linearGradient id="ai-cta-gradient" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0ea5e9" />
      <stop offset="100%" stop-color="#6366f1" />
    </linearGradient>
  </defs>
</svg>
</div><!-- /.demo-scope -->

    <!-- Website footer -->
    <footer class="relative z-10 border-t border-slate-800/50 px-6 py-8">
      <div class="mx-auto flex max-w-7xl items-center justify-between text-sm text-slate-500">
        <span>&copy; 2026 {t.footer.copyright}</span>
        <div class="flex items-center gap-4">
          <span class="text-xs text-slate-600">v{version}</span>
          <a
            href="https://github.com/michaelsogos/primebrick-v3-website"
            class="inline-flex items-center gap-1.5 hover:text-sky-400 transition-colors"
            target="_blank"
            rel="noopener"
          >
            <GitHubIcon class="h-4 w-4" />
            GitHub®
          </a>
        </div>
      </div>
    </footer>

    <script>
      import { renderAllIcons } from '../../../scripts/demo/icons';
      import { initExportsScroll } from '../../../scripts/demo/exports-scroll';
      renderAllIcons();
      initExportsScroll();
    </script>
  </body>
</html>
