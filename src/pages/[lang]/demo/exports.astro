---
import { translations, LANGUAGES, type LangCode } from '../../../i18n/translations';
import { exportsTranslations } from '../../../i18n/exports-translations';
import LanguageSwitcher from '../../../components/svelte/LanguageSwitcher.svelte';
import GitHubDropdown from '../../../components/svelte/GitHubDropdown.svelte';
import VirtualTourMegaMenu from '../../../components/svelte/VirtualTourMegaMenu.svelte';
import UseCasesMegaMenu from '../../../components/svelte/UseCasesMegaMenu.svelte';
import GitHubIcon from '../../../components/GitHubIcon.astro';
import TopBanner from '../../../components/astro/TopBanner.astro';
import DemoHero from '../../../components/astro/DemoHero.astro';
import pkg from '../../../../package.json';
import '../../../styles/global.css';
import '../../../styles/demo/demo.css';
import '../../../styles/demo/exports.css';

const version = pkg.version;

export const prerender = true;

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang: lang.code === 'en' ? 'en' : lang.code },
  }));
}

const { lang } = Astro.params;
const langCode = (lang ?? 'en') as LangCode;
const t = translations[langCode] ?? translations.en;
const et = exportsTranslations[langCode] ?? exportsTranslations.en;
const isEn = langCode === 'en';
const docsPath = 'https://docs.primebrick.dev';
const homeHref = isEn ? '/en/' : `/${langCode}/`;
const contactHref = isEn ? '/en/contact' : `/${langCode}/contact`;
const thankyouHref = isEn ? '/en/thank-you' : `/${langCode}/thank-you`;
const demoHref = isEn ? '/en/demo/' : `/${langCode}/demo/`;
---

<!doctype html>
<html lang={langCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={et.pageSubtitle.slice(0, 160)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />
    <title>Primebrick — {t.demo.card.exports.title}</title>
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={`https://primebrick.dev${l.code === 'en' ? '/en/demo/exports' : `/${l.code}/demo/exports`}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://primebrick.dev/en/demo/exports" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <!-- Ambient gradient background (website) -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-sky-500/10 blur-[120px]"></div>
      <div class="absolute top-1/3 -right-40 h-[400px] w-[400px] rounded-full bg-indigo-500/10 blur-[100px]"></div>
      <div class="absolute bottom-0 -left-40 h-[400px] w-[400px] rounded-full bg-cyan-500/10 blur-[100px]"></div>
    </div>

    <!-- Top banner (sticky, non-dismissible) -->
    <TopBanner text={t.banner.text} href={contactHref} />

    <!-- Navigation (sticky, condensing on scroll) -->
    <nav id="site-nav" class="sticky top-9 z-50 border-b border-slate-800/50 bg-slate-950/40 backdrop-blur-sm transition-all duration-300">
      <div id="nav-inner" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 transition-all duration-300">
        <a href={homeHref} class="flex items-center gap-2 transition-all duration-300" id="nav-logo" aria-label="PrimeBrick home">
          <img src="/logo-full-dark.svg" alt="PrimeBrick" width="170" height="32" class="h-7 w-auto" />
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a href={homeHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.home}</a>
          <VirtualTourMegaMenu client:load currentLang={langCode} activeDemo="exports" />
          <UseCasesMegaMenu client:load currentLang={langCode} />
          <a href={docsPath} class="text-slate-300 hover:text-sky-400 transition-colors" target="_blank" rel="noopener">{t.nav.docs}</a>
          <a href={contactHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.contact}</a>
          <a href={thankyouHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.thankyou}</a>
          <a
            href="https://opensource.org/license/MIT"
            class="text-slate-300 hover:text-sky-400 transition-colors"
            target="_blank"
            rel="noopener"
          >
            {t.nav.license}
          </a>
          <GitHubDropdown client:load />
          <LanguageSwitcher client:load currentLang={langCode} />
        </div>
      </div>
    </nav>
    <script>
      (() => {
        const nav = document.getElementById('site-nav');
        const inner = document.getElementById('nav-inner');
        const logo = document.getElementById('nav-logo');
        if (!nav || !inner) return;
        const onScroll = () => {
          const scrolled = window.scrollY > 20;
          if (scrolled) {
            inner.classList.replace('py-4', 'py-2');
            nav.classList.add('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.remove('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-xl', 'text-lg');
          } else {
            inner.classList.replace('py-2', 'py-4');
            nav.classList.remove('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.add('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-lg', 'text-xl');
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <!-- ===== Demo body (scoped) ===== -->

<div class="demo-scope">

<!-- Hero (badge + gradient h1 + subtitle) -->
<DemoHero badge={et.pageBadge} title={et.pageTitle} subtitle={et.pageSubtitle} badgeColor="bg-violet-400" gradientVia="via-violet-200" />

<!-- Scroll hint -->
<div class="demo-scroll-hint" id="scroll-hint">{et.scrollHint}</div>

<!-- ===== Section claims (6, alternating right/left) ===== -->
<!-- Claim 0: Export Buttons (right) -->
<div class="section-claim" id="claim-0">
  <div class="claim-eyebrow">{et.claim0Eyebrow}</div>
  <div class="claim-title" set:html={et.claim0Title} />
  <div class="claim-subtitle">{et.claim0Subtitle}</div>
</div>
<!-- Claim 1: Scope Selection (left) -->
<div class="section-claim left" id="claim-1">
  <div class="claim-eyebrow">{et.claim1Eyebrow}</div>
  <div class="claim-title" set:html={et.claim1Title} />
  <div class="claim-subtitle">{et.claim1Subtitle}</div>
</div>

<!-- Modal preview: export dialog shown centered over the mock during phase 1 -->
<!-- Matches FE ExportDialog.svelte: DialogBordered severity="warning" + Choicebox + warning buttons -->
<div class="modal-preview" id="modal-preview">
  <div class="mp-overlay"></div>
  <div class="mp-content">
    <!-- Top accent strip (warning gradient — matches DialogBordered severity="warning") -->
    <div class="mp-top-strip"></div>
    <!-- Inner padded wrapper (p-4) -->
    <div class="mp-inner">
      <!-- Header (pb-4) -->
      <div class="mp-header">
        <div class="mp-title">{et.mockExportDataTitle}</div>
        <div class="mp-description">{et.mockExportQuestion}</div>
      </div>
      <!-- Body (py-4) — Choicebox -->
      <div class="mp-body">
        <div class="mp-choicebox">
          <div class="mp-choicebox-item selected">
            <div class="mp-choicebox-content">
              <div class="mp-choicebox-title">{et.mockSelectedOnly}</div>
              <div class="mp-choicebox-desc">{et.mockSelectedOnlyDesc}</div>
            </div>
            <div class="mp-choicebox-indicator"><div class="mp-radio"><div class="mp-radio-dot"></div></div></div>
          </div>
          <div class="mp-choicebox-item">
            <div class="mp-choicebox-content">
              <div class="mp-choicebox-title">{et.mockAllItems}</div>
              <div class="mp-choicebox-desc">{et.mockAllItemsDesc}</div>
            </div>
            <div class="mp-choicebox-indicator"><div class="mp-radio"><div class="mp-radio-dot"></div></div></div>
          </div>
        </div>
      </div>
      <!-- Footer (gap-2, flex-col sm:flex-row) -->
      <div class="mp-footer">
        <button class="mp-btn-secondary-outline">{et.mockCancel}</button>
        <div class="mp-btn-group">
          <button class="mp-btn-warning"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M14 4.5V11h-1V4.5h-2A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v9H2V2a2 2 0 0 1 2-2h5.5zM7.86 14.841a1.13 1.13 0 0 0 .401.823q.195.162.479.252.284.091.665.091.507 0 .858-.158.355-.158.54-.44a1.17 1.17 0 0 0 .187-.656q0-.336-.135-.56a1 1 0 0 0-.375-.357 2 2 0 0 0-.565-.21l-.621-.144a1 1 0 0 1-.405-.176.37.37 0 0 1-.143-.299q0-.234.184-.384.188-.152.513-.152.214 0 .37.068a.6.6 0 0 1 .245.181.56.56 0 0 1 .12.258h.75a1.1 1.1 0 0 0-.199-.566 1.2 1.2 0 0 0-.5-.41 1.8 1.8 0 0 0-.78-.152q-.44 0-.777.15-.336.149-.527.421-.19.273-.19.639 0 .302.123.524t.351.367q.229.143.54.213l.618.144q.31.073.462.193a.39.39 0 0 1 .153.326.5.5 0 0 1-.085.29.56.56 0 0 1-.255.193q-.168.07-.413.07-.176 0-.32-.04a.8.8 0 0 1-.249-.115.58.58 0 0 1-.255-.384zm-3.726-2.909h.893l-1.274 2.007 1.254 1.992h-.908l-.85-1.415h-.035l-.853 1.415H1.5l1.24-2.016-1.228-1.983h.931l.832 1.438h.036zm1.923 3.325h1.697v.674H5.266v-3.999h.791zm7.636-3.325h.893l-1.274 2.007 1.254 1.992h-.908l-.85-1.415h-.035l-.853 1.415h-.861l1.24-2.016-1.228-1.983h.931l.832 1.438h.036z"/></svg>{et.mockExportExcel}</button>
          <button class="mp-btn-warning"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M14 4.5V14a2 2 0 0 1-2 2h-1v-1h1a1 1 0 0 0 1-1V4.5h-2A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v9H2V2a2 2 0 0 1 2-2h5.5zM3.517 14.841a1.13 1.13 0 0 0 .401.823q.195.162.478.252.284.091.665.091.507 0 .859-.158.354-.158.539-.44.187-.284.187-.656 0-.336-.134-.56a1 1 0 0 0-.375-.357 2 2 0 0 0-.566-.21l-.621-.144a1 1 0 0 1-.404-.176.37.37 0 0 1-.144-.299q0-.234.185-.384.188-.152.512-.152.214 0 .37.068a.6.6 0 0 1 .246.181.56.56 0 0 1 .12.258h.75a1.1 1.1 0 0 0-.2-.566 1.2 1.2 0 0 0-.5-.41 1.8 1.8 0 0 0-.78-.152q-.439 0-.776.15-.337.149-.527.421-.19.273-.19.639 0 .302.122.524.124.223.352.367.228.143.539.213l.618.144q.31.073.463.193a.39.39 0 0 1 .152.326.5.5 0 0 1-.085.29.56.56 0 0 1-.255.193q-.167.07-.413.07-.175 0-.32-.04a.8.8 0 0 1-.248-.115.58.58 0 0 1-.255-.384zM.806 13.693q0-.373.102-.633a.87.87 0 0 1 .302-.399.8.8 0 0 1 .475-.137q.225 0 .398.097a.7.7 0 0 1 .272.26.85.85 0 0 1 .12.381h.765v-.072a1.33 1.33 0 0 0-.466-.964 1.4 1.4 0 0 0-.489-.272 1.8 1.8 0 0 0-.606-.097q-.534 0-.911.223-.375.222-.572.632-.195.41-.196.979v.498q0 .568.193.976.197.407.572.626.375.217.914.217.439 0 .785-.164t.55-.454a1.27 1.27 0 0 0 .226-.674v-.076h-.764a.8.8 0 0 1-.118.363.7.7 0 0 1-.272.25.9.9 0 0 1-.401.087.85.85 0 0 1-.478-.132.83.83 0 0 1-.299-.392 1.7 1.7 0 0 1-.102-.627zm8.239 2.238h-.953l-1.338-3.999h.917l.896 3.138h.038l.888-3.138h.879z"/></svg>{et.mockExportCsv}</button>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Claim 2: Server-Generated (right) -->
<div class="section-claim" id="claim-2">
  <div class="claim-eyebrow">{et.claim2Eyebrow}</div>
  <div class="claim-title" set:html={et.claim2Title} />
  <div class="claim-subtitle">{et.claim2Subtitle}</div>
</div>
<!-- Claim 3: HTML Export (left) -->
<div class="section-claim left" id="claim-3">
  <div class="claim-eyebrow">{et.claim3Eyebrow}</div>
  <div class="claim-title" set:html={et.claim3Title} />
  <div class="claim-subtitle">{et.claim3Subtitle}</div>
</div>
<!-- Claim 4: Live Preview (right) -->
<div class="section-claim" id="claim-4">
  <div class="claim-eyebrow">{et.claim4Eyebrow}</div>
  <div class="claim-title" set:html={et.claim4Title} />
  <div class="claim-subtitle">{et.claim4Subtitle}</div>
</div>

<!-- Final conclusion claim -->
<div class="section-claim-final" id="claim-final">
  <div class="claim-title-final" set:html={et.claimFinalTitle} />
</div>

<!-- Progress rail + dots + phase label -->
<div class="progress-rail"><div class="progress-rail-fill" id="rail-fill" style="height:0%"></div></div>
<div class="scene-dots" id="dots"></div>
<div class="phase-label" id="phase-label">Intro</div>

<!-- Scroll track -->
<div class="scroll-track" style="height: 2000vh" id="track">
  <div class="scroll-stage" id="stage">
    <div class="scroll-canvas" id="canvas">

      <!-- ===== Screen mock (collapsed sidebar + topbar + content with table) ===== -->
      <div class="screen-mock" id="screen-mock">
        <div class="browser-bar">
          <div class="browser-dots"><span class="browser-dot red"></span><span class="browser-dot yellow"></span><span class="browser-dot green"></span></div>
          <div class="browser-url"><span class="url-lock">🔒</span>https://backoffice.acme.org/customers</div>
        </div>
        <div class="app-body">
          <!-- Collapsed sidebar (rail) -->
          <div class="pb-sidebar">
            <div class="sb-rail-avatar">AC</div>
            <div class="sb-rail-icon"><i data-icon="settings"></i></div>
            <div class="sb-rail-icon active"><i data-icon="users"></i></div>
            <div class="sb-rail-spacer"></div>
            <div class="sb-rail-profile">JD</div>
            <div class="sb-rail-health"></div>
          </div>
          <!-- Main -->
          <div class="pb-main">
            <!-- Topbar -->
            <div class="pb-header" id="topbar">
              <div class="pb-header-left">
                <button class="pb-header-toggle"><i data-icon="panelLeft"></i></button>
                <div class="pb-header-search"><i data-icon="search"></i>{et.searchPlaceholder}<span class="kbd">{et.searchShortcut}</span></div>
                <button class="pb-header-btn pb-ai-cta" title="AI Assistant"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><path d="M6 20a2 2 0 1 1-4 0 2 2 0 0 1 4 0"/></svg></button>
              </div>
              <div class="pb-header-right">
                <div class="pb-header-tz" id="mock-browser-tz"><i data-icon="globe"></i>Europe/Rome</div>
                <button class="pb-header-lang">IT<i data-icon="chevronDown"></i></button>
                <button class="pb-header-btn" title="Errors"><i data-icon="triangleAlert"></i></button>
                <button class="pb-header-btn" title="Notifications"><i data-icon="bell"></i><span class="btn-badge">3</span></button>
                <button class="pb-header-btn" title="Theme"><i data-icon="moon"></i></button>
              </div>
            </div>
            <!-- Content area (the source for all extractions) -->
            <div class="pb-content" id="content-area">
              <div class="pb-breadcrumb">{et.breadcrumbSystem} / {et.breadcrumbSettings} / <span class="crumb-current">{et.breadcrumbCustomers}</span></div>
              <!-- First toolbar: search (left) + view mode, deletion filter, refresh, columns, filters, divider, New (right) -->
              <div class="pb-toolbar" style="border-bottom:1px solid var(--pb-border);padding:0.5rem 0.75rem">
                <div class="pb-search-input" id="src-search" style="max-width:240px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input placeholder={et.toolbarSearchPlaceholder}><button class="pb-search-scope">{et.searchScopeAllFields}</button></div>
                <div style="margin-left:auto;display:flex;align-items:center;gap:0.375rem">
                  <div class="pb-soft-gradient-group" id="src-view-toggle">
                    <div class="sg-btn active" id="src-vt-table" title="Table"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg></div>
                    <div class="sg-btn" id="src-vt-cards" title="Cards"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg></div>
                    <div class="sg-btn" id="src-vt-list" title="Cards list"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><path d="M14 4h7"/><path d="M14 9h7"/><path d="M14 15h7"/><path d="M14 20h7"/></svg></div>
                  </div>
                  <div class="pb-del-filter" id="src-del-filter">
                    <div class="df-btn active" id="src-df-active" title="Active records"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5H3"/><path d="M16 12H3"/><path d="M11 19H3"/><path d="m15 18 2 2 4-4"/></svg></div>
                    <div class="df-btn" id="src-df-deleted" title="Deleted records"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5H3"/><path d="M11 12H3"/><path d="M16 19H3"/><path d="m15.5 9.5 5 5"/><path d="m20.5 9.5-5 5"/></svg></div>
                    <div class="df-btn" id="src-df-all" title="All records"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18"/><path d="M3 12h18"/><path d="M3 19h18"/></svg></div>
                  </div>
                  <button class="pb-btn-soft-icon" title="Refresh"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg></button>
                  <button class="pb-btn-soft" id="src-columns-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>{et.toolbarColumns}</button>
                  <button class="pb-btn-soft" id="src-filter-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5H3"/><path d="M12 19H3"/><path d="M14 3v4"/><path d="M16 17v4"/><path d="M21 12h-9"/><path d="M21 19h-5"/><path d="M21 5h-7"/><path d="M8 10v4"/><path d="M8 12H3"/></svg>{et.toolbarFilters}</button>
                  <div class="pb-gradient-divider"></div>
                  <button class="pb-btn-primary-gradient">{et.toolbarNew}</button>
                </div>
              </div>
              <!-- Second toolbar: toggle (filters/bulk) + Clear all + filter chips -->
              <div class="pb-toolbar-second" id="src-toolbar-second">
                <!-- Filters mode content (visible by default) -->
                <div id="src-toolbar-filters" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                  <button class="pb-btn-outline" id="src-toggle-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5H3"/><path d="M16 12H3"/><path d="M11 19H3"/><path d="m15 18 2 2 4-4"/></svg><span id="src-toggle-label">{et.toolbarBulkActions}</span></button>
                  <div class="pb-gradient-divider"></div>
                  <button class="pb-btn-soft-xs"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>{et.toolbarClearAll}</button>
                  <div class="pb-gradient-divider"></div>
                  <div class="pb-filter-badge">
                    <span class="fb-label">{et.filterFieldEmail}</span>
                    <span class="fb-op">{et.filterOpEndsWith}</span>
                    <span class="fb-val">.com</span>
                    <button class="fb-x"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                  </div>
                </div>
                <!-- Bulk mode content (hidden by default, toggled in during export buttons phase) -->
                <div id="src-toolbar-bulk" style="display:none;align-items:center;gap:0.5rem;flex-wrap:wrap">
