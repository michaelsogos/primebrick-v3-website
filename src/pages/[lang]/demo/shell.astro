---
import { translations, LANGUAGES, type LangCode } from '../../../i18n/translations';
import LanguageSwitcher from '../../../components/svelte/LanguageSwitcher.svelte';
import GitHubDropdown from '../../../components/svelte/GitHubDropdown.svelte';
import VirtualTourMegaMenu from '../../../components/svelte/VirtualTourMegaMenu.svelte';
import GitHubIcon from '../../../components/GitHubIcon.astro';
import TopBanner from '../../../components/astro/TopBanner.astro';
import pkg from '../../../../package.json';
import '../../../styles/global.css';
import '../../../styles/demo/shell.css';

const version = pkg.version;

export const prerender = true;

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang: lang.code === 'en' ? 'en' : lang.code },
  }));
}

const { lang } = Astro.params;
const langCode = (lang ?? 'en') as LangCode;
const t = translations[langCode] ?? translations.en;
const isEn = langCode === 'en';
const docsPath = 'https://docs.primebrick.dev';
const homeHref = isEn ? '/en/' : `/${langCode}/`;
const contactHref = isEn ? '/en/contact' : `/${langCode}/contact`;
const thankyouHref = isEn ? '/en/thank-you' : `/${langCode}/thank-you`;
const demoHref = isEn ? '/en/demo/' : `/${langCode}/demo/`;
const shellHref = `${demoHref}shell`;
---

<!doctype html>
<html lang={langCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.demo.card.shell.desc.slice(0, 160)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />
    <title>Primebrick — {t.demo.shellTitle}</title>
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={`https://primebrick.dev${l.code === 'en' ? '/en/demo/shell' : `/${l.code}/demo/shell`}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://primebrick.dev/en/demo/shell" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <!-- Ambient gradient background (website) -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-sky-500/10 blur-[120px]"></div>
      <div class="absolute top-1/3 -right-40 h-[400px] w-[400px] rounded-full bg-indigo-500/10 blur-[100px]"></div>
      <div class="absolute bottom-0 -left-40 h-[400px] w-[400px] rounded-full bg-cyan-500/10 blur-[100px]"></div>
    </div>

    <!-- Top banner (sticky, non-dismissible) -->
    <TopBanner text={t.banner.text} href={contactHref} />

    <!-- Navigation (sticky, condensing on scroll) -->
    <nav id="site-nav" class="sticky top-9 z-50 border-b border-slate-800/50 bg-slate-950/40 backdrop-blur-sm transition-all duration-300">
      <div id="nav-inner" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 transition-all duration-300">
        <a href={homeHref} class="flex items-center gap-2 transition-all duration-300" id="nav-logo" aria-label="PrimeBrick home">
          <img src="/logo-full-dark.svg" alt="PrimeBrick" width="170" height="32" class="h-7 w-auto" />
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a href={homeHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.home}</a>
          <VirtualTourMegaMenu client:load currentLang={langCode} activeDemo="shell" />
          <a href={docsPath} class="text-slate-300 hover:text-sky-400 transition-colors" target="_blank" rel="noopener">{t.nav.docs}</a>
          <a href={contactHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.contact}</a>
          <a href={thankyouHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.thankyou}</a>
          <a
            href="https://opensource.org/license/MIT"
            class="text-slate-300 hover:text-sky-400 transition-colors"
            target="_blank"
            rel="noopener"
          >
            {t.nav.license}
          </a>
          <GitHubDropdown client:load />
          <LanguageSwitcher client:load currentLang={langCode} />
        </div>
      </div>
    </nav>
    <script>
      (() => {
        const nav = document.getElementById('site-nav');
        const inner = document.getElementById('nav-inner');
        const logo = document.getElementById('nav-logo');
        if (!nav || !inner) return;
        const onScroll = () => {
          const scrolled = window.scrollY > 20;
          if (scrolled) {
            inner.classList.replace('py-4', 'py-2');
            nav.classList.add('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.remove('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-xl', 'text-lg');
          } else {
            inner.classList.replace('py-2', 'py-4');
            nav.classList.remove('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.add('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-lg', 'text-xl');
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <!-- ===== Demo body (from shell-v2.html, scoped) ===== -->

<div class="demo-scope">

<!-- Hero (matches the website pattern: badge + gradient h1 + subtitle) -->
<section class="relative z-10 px-6 pt-24 pb-16 text-center">
  <div class="mx-auto max-w-3xl">
    <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-700/50 bg-slate-900/50 px-4 py-1.5 text-xs font-medium text-slate-400 backdrop-blur-sm">
      <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      {t.demo.shellBadge}
    </div>
    <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl">
      <span class="bg-gradient-to-b from-white via-sky-200 to-slate-400 bg-clip-text text-transparent">
        {t.demo.shellTitle}
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400 sm:text-xl">
      {t.demo.shellSubtitle}
    </p>
  </div>
</section>

<!-- Scroll hint — scrolls away with the page (not fixed) -->
<div class="demo-scroll-hint" id="scroll-hint">↓ Scroll to control the animation</div>

<!-- Section claim — appears during sidebar disassembly, right-aligned above the mock -->
<div class="section-claim" id="section-claim">
  <div class="claim-eyebrow">The Sidebar</div>
  <div class="claim-title">The smartest sidebar<br>in any backoffice.</div>
  <div class="claim-subtitle">Switch organizations, modules, and contexts in seconds. Every brick registers itself — no config, no reload.</div>
</div>

<!-- Section claim — appears during topbar disassembly, left-aligned (mirrors sidebar) -->
<div class="section-claim-topbar" id="section-claim-topbar">
  <div class="claim-eyebrow">The Topbar</div>
  <div class="claim-title">Everything you need,<br>one strip away.</div>
  <div class="claim-subtitle">Command palette, timezone, language, notifications, AI assistant, and theme — a passive strip for quick access and at-a-glance info. Just context.</div>
</div>

<!-- Progress rail + dots -->
<div class="progress-rail"><div class="progress-rail-fill" id="rail-fill" style="height:0%"></div></div>
<div class="scene-dots" id="dots"></div>
<div class="phase-label" id="phase-label">Intro</div>

<!-- Scroll track -->
<div class="scroll-track" style="height: 2000vh" id="track">
  <div class="scroll-stage" id="stage">
    <div class="scroll-canvas" id="canvas">

      <!-- ===== Screen mock (real Primebrick look) ===== -->
      <div class="screen-mock" id="screen-mock">
        <div class="browser-bar">
          <div class="browser-dots"><span class="browser-dot red"></span><span class="browser-dot yellow"></span><span class="browser-dot green"></span></div>
          <div class="browser-url">🔒 https://backoffice.acme.org/system/settings/profile</div>
        </div>
        <div class="app-body">
          <!-- Sidebar -->
          <div class="pb-sidebar" id="sidebar">
            <div class="pb-sidebar-gap" id="sidebar-gap"></div>
            <div class="sb-section" id="sb-org-section">
              <div class="sb-label">Organizzazione</div>
              <button class="sb-trigger" id="sb-org">
                <div class="sb-trigger-avatar"><i data-icon="building2"></i></div>
                <span class="sb-trigger-text">Acme Corp</span>
                <i data-icon="chevronsUpDown" class="sb-trigger-chevron"></i>
              </button>
            </div>
            <div class="sb-section" id="sb-module-section">
              <div class="sb-label">Modulo</div>
              <button class="sb-trigger" id="sb-module">
                <div class="sb-trigger-avatar"><i data-icon="settings"></i></div>
                <span class="sb-trigger-text">Settings</span>
                <i data-icon="chevronsUpDown" class="sb-trigger-chevron"></i>
              </button>
            </div>
            <div class="sb-section" id="sb-nav-section">
              <div class="sb-label">Collegamenti</div>
              <div class="sb-nav" id="sb-nav">
                <div class="sb-nav-item active"><i data-icon="squareUser"></i>Profile</div>
                <div class="sb-nav-item" style="opacity:0.85"><i data-icon="keyRound"></i>Credentials</div>
                <div class="sb-nav-item" style="opacity:0.65"><i data-icon="building2"></i>Organizations</div>
                <div class="sb-nav-item" style="opacity:0.45"><i data-icon="users"></i>Users</div>
                <div class="sb-nav-item" style="opacity:0.25"><i data-icon="userKey"></i>Roles</div>
                <div class="sb-nav-item" style="opacity:0.1;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="shieldCheck"></i>Security</div>
                <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="package"></i>Modules</div>
                <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="fileText"></i>Templates</div>
                <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="mail"></i>Email Providers</div>
              </div>
            </div>
            <div class="sb-footer" id="sb-footer">
              <div class="sb-footer-label">Profilo</div>
              <div class="sb-profile" id="sb-profile">
                <div class="sb-profile-avatar">JD</div>
                <span class="sb-profile-name">John Doe</span>
                <svg class="sb-profile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
              </div>
              <div class="sb-separator"></div>
              <div class="sb-badges" id="sb-badges">
                <span class="sb-badge online">Online</span>
                <span class="sb-badge version">v0.37.0</span>
              </div>
            </div>
          </div>

          <!-- Main content -->
          <div class="pb-main">
            <!-- Top nav bar -->
            <div class="pb-header" id="topbar">
              <div class="pb-header-left">
                <button class="pb-header-toggle" id="tb-toggle"><i data-icon="panelLeft"></i></button>
                <div class="pb-header-search" id="tb-search">
                  <i data-icon="search"></i>Search...<span class="kbd">Ctrl K</span>
                </div>
                <button class="pb-header-btn pb-ai-cta" id="tb-ai" title="AI Assistant"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><path d="M6 20a2 2 0 1 1-4 0 2 2 0 0 1 4 0"/></svg></button>
              </div>
              <div class="pb-header-right">
                <div class="pb-header-tz" id="tb-tz"><i data-icon="globe"></i>Europe/Rome</div>
                <button class="pb-header-lang" id="tb-lang">IT<i data-icon="chevronDown"></i></button>
                <button class="pb-header-btn" id="tb-errors" title="Errors"><i data-icon="triangleAlert"></i></button>
                <button class="pb-header-btn" id="tb-notif" title="Notifications"><i data-icon="bell"></i><span class="btn-badge">3</span></button>
                <button class="pb-header-btn" id="tb-theme" title="Theme"><i data-icon="moon"></i></button>
              </div>
            </div>
            <!-- Page content — profile settings skeleton (inspired by /system/settings/profile) -->
            <div class="pb-content">
              <div class="pb-breadcrumb">System / Settings / <span style="color:var(--pb-fg)">Profile</span></div>
              <h2 class="pb-page-title">Profile</h2>
              <!-- Settings form skeleton -->
              <div style="display:flex;flex-direction:column;gap:1.25rem;max-width:560px">
                <!-- Avatar + name row -->
                <div style="display:flex;align-items:center;gap:1rem">
                  <div style="width:64px;height:64px;clip-path:polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);background:linear-gradient(135deg,#0ea5e9,#6366f1);display:grid;place-items:center;color:white;font-size:1.125rem;font-weight:700">JD</div>
                  <div style="display:flex;flex-direction:column;gap:0.25rem">
                    <div style="font-size:0.875rem;font-weight:600;color:var(--pb-fg)">John Doe</div>
                    <button class="pb-btn-soft" style="font-size:0.6875rem"><i data-icon="upload"></i>Change photo</button>
                  </div>
                </div>
                <!-- Form fields -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                  <div style="display:flex;flex-direction:column;gap:0.3125rem">
                    <label style="font-size:0.6875rem;font-weight:500;color:var(--pb-muted-fg)">First name</label>
                    <div style="padding:0.4375rem 0.625rem;border:1px solid var(--pb-border);border-radius:var(--pb-radius);font-size:0.75rem;color:var(--pb-fg);background:var(--pb-bg)">John</div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:0.3125rem">
                    <label style="font-size:0.6875rem;font-weight:500;color:var(--pb-muted-fg)">Last name</label>
                    <div style="padding:0.4375rem 0.625rem;border:1px solid var(--pb-border);border-radius:var(--pb-radius);font-size:0.75rem;color:var(--pb-fg);background:var(--pb-bg)">Doe</div>
                  </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:0.3125rem">
                  <label style="font-size:0.6875rem;font-weight:500;color:var(--pb-muted-fg)">Email</label>
                  <div style="padding:0.4375rem 0.625rem;border:1px solid var(--pb-border);border-radius:var(--pb-radius);font-size:0.75rem;color:var(--pb-muted-fg);background:var(--pb-bg)">john.doe@acme.com</div>
                </div>
                <div style="display:flex;flex-direction:column;gap:0.3125rem">
                  <label style="font-size:0.6875rem;font-weight:500;color:var(--pb-muted-fg)">Language</label>
                  <div style="padding:0.4375rem 0.625rem;border:1px solid var(--pb-border);border-radius:var(--pb-radius);font-size:0.75rem;color:var(--pb-fg);background:var(--pb-bg);display:flex;align-items:center;justify-content:space-between">English (US) <i data-icon="chevronDown" style="width:14px;height:14px;color:var(--pb-muted-fg)"></i></div>
                </div>
                <div style="display:flex;flex-direction:column;gap:0.3125rem">
                  <label style="font-size:0.6875rem;font-weight:500;color:var(--pb-muted-fg)">Timezone</label>
                  <div style="padding:0.4375rem 0.625rem;border:1px solid var(--pb-border);border-radius:var(--pb-radius);font-size:0.75rem;color:var(--pb-fg);background:var(--pb-bg);display:flex;align-items:center;justify-content:space-between">Europe/Rome <i data-icon="chevronDown" style="width:14px;height:14px;color:var(--pb-muted-fg)"></i></div>
                </div>
                <!-- Action buttons -->
                <div style="display:flex;gap:0.5rem;padding-top:0.5rem">
                  <button style="padding:0.4375rem 1rem;border-radius:var(--pb-radius);border:none;background:var(--pb-primary);color:var(--pb-primary-fg);font-size:0.75rem;font-weight:600;cursor:pointer">Save changes</button>
                  <button class="pb-btn-soft" style="font-size:0.75rem">Cancel</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== Extracted sidebar (slides out from screen) ===== -->
      <div class="sidebar-extracted" id="sidebar-extracted">
        <div class="sb-section" id="ex-org-section">
          <div class="sb-label">Organizzazione</div>
          <button class="sb-trigger" id="ex-org">
            <div class="sb-trigger-avatar"><i data-icon="building2"></i></div>
            <span class="sb-trigger-text">Acme Corp</span>
            <i data-icon="chevronsUpDown" class="sb-trigger-chevron"></i>
          </button>
        </div>
        <div class="sb-section" id="ex-module-section">
          <div class="sb-label">Modulo</div>
          <button class="sb-trigger" id="ex-module">
            <div class="sb-trigger-avatar"><i data-icon="settings"></i></div>
            <span class="sb-trigger-text">Settings</span>
            <i data-icon="chevronsUpDown" class="sb-trigger-chevron"></i>
          </button>
        </div>
        <div class="sb-section" id="ex-nav-section">
          <div class="sb-label">Collegamenti</div>
          <div class="sb-nav" id="ex-nav">
            <div class="sb-nav-item active"><i data-icon="squareUser"></i>Profile</div>
            <div class="sb-nav-item" style="opacity:0.85"><i data-icon="keyRound"></i>Credentials</div>
            <div class="sb-nav-item" style="opacity:0.65"><i data-icon="building2"></i>Organizations</div>
            <div class="sb-nav-item" style="opacity:0.45"><i data-icon="users"></i>Users</div>
            <div class="sb-nav-item" style="opacity:0.25"><i data-icon="userKey"></i>Roles</div>
            <div class="sb-nav-item" style="opacity:0.1;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="shieldCheck"></i>Security</div>
            <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="package"></i>Modules</div>
            <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="fileText"></i>Templates</div>
            <div class="sb-nav-item" style="opacity:0;height:0;padding:0;margin:0;overflow:hidden"><i data-icon="mail"></i>Email Providers</div>
          </div>
        </div>
        <div class="sb-footer" id="ex-footer">
          <div class="sb-footer-label">Profilo</div>
          <div class="sb-profile" id="ex-profile">
            <div class="sb-profile-avatar">JD</div>
            <span class="sb-profile-name">John Doe</span>
            <svg class="sb-profile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
          </div>
          <div class="sb-separator"></div>
          <div class="sb-badges">
            <span class="sb-badge online">Online</span>
            <span class="sb-badge version">v0.37.0</span>
          </div>
        </div>
      </div>

      <!-- ===== Sidebar annotations (left side, pointing right) ===== -->
      <div class="ann-label" id="ann-org"><div class="ann-card"><div class="ann-title">Organization Switcher</div><div class="ann-desc">Switch between organizations. Each has its own modules, users, and data.</div></div></div>
      <div class="ann-label" id="ann-module"><div class="ann-card"><div class="ann-title">Module Switcher</div><div class="ann-desc">Each brick registers itself automatically. Switch context without leaving the app.</div></div></div>
      <div class="ann-label" id="ann-nav"><div class="ann-card"><div class="ann-title">Dynamic Navigation</div><div class="ann-desc">Links are fetched from each module at runtime. New bricks appear here instantly.</div></div></div>
      <div class="ann-label" id="ann-profile"><div class="ann-card"><div class="ann-title">Profile & Session</div><div class="ann-desc">Your identity, roles, and permissions. Sign out or manage security settings.</div></div></div>
      <div class="ann-label" id="ann-health"><div class="ann-card"><div class="ann-title">Health & Version</div><div class="ann-desc">Real-time status of database, cache, messaging, and identity provider.</div></div></div>

      <!-- ===== Top nav annotations (above topbar, pointing down) ===== -->
      <div class="ann-label" id="ann-toggle"><div class="ann-card"><div class="ann-title">Sidebar Toggle</div><div class="ann-desc">Collapse or expand the sidebar. State persists across sessions.</div></div></div>
      <div class="ann-label" id="ann-search"><div class="ann-card"><div class="ann-title">Command Palette</div><div class="ann-desc">Search anything, run commands, jump to pages. Press Ctrl+K anywhere.</div></div></div>
      <div class="ann-label" id="ann-tz"><div class="ann-card"><div class="ann-title">Timezone</div><div class="ann-desc">IANA timezone detected automatically. All timestamps respect this setting.</div></div></div>
      <div class="ann-label" id="ann-lang"><div class="ann-card"><div class="ann-title">Language</div><div class="ann-desc">Switch UI language. Every label is localized at runtime.</div></div></div>
      <div class="ann-label" id="ann-errors"><div class="ann-card"><div class="ann-title">Error Panel</div><div class="ann-desc">Active errors and warnings across all modules. Click to inspect details.</div></div></div>
      <div class="ann-label" id="ann-notif"><div class="ann-card"><div class="ann-title">Notifications</div><div class="ann-desc">Real-time alerts from background jobs, webhooks, and system events. Integrated push notifications via the Event Center, handled directly by the OS.</div></div></div>
      <div class="ann-label" id="ann-ai"><div class="ann-card"><div class="ann-title">AI Assistant</div><div class="ann-desc">Context-aware help. Ask questions about your data or request automations.</div></div></div>
      <div class="ann-label" id="ann-theme"><div class="ann-card"><div class="ann-title">Theme Toggle</div><div class="ann-desc">Switch between light and dark mode. Preference is saved per user.</div></div></div>

      <!-- ===== Extracted topbar (slides up out of screen) ===== -->
      <div class="topbar-extracted" id="topbar-extracted">
        <div class="pb-header-left">
          <button class="pb-header-toggle" id="ex-tb-toggle"><i data-icon="panelLeft"></i></button>
          <div class="pb-header-search" id="ex-tb-search">
            <i data-icon="search"></i>Search...<span class="kbd">Ctrl K</span>
          </div>
