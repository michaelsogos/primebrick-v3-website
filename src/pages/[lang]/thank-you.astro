---
import { translations, LANGUAGES, type LangCode } from '../../i18n/translations';
import LanguageSwitcher from '../../components/svelte/LanguageSwitcher.svelte';
import GitHubDropdown from '../../components/svelte/GitHubDropdown.svelte';
import GitHubIcon from '../../components/GitHubIcon.astro';
import TopBanner from '../../components/astro/TopBanner.astro';
import OpenSourceHeart from '../../components/OpenSourceHeart.astro';
import ThankYouScroll from '../../components/svelte/ThankYouScroll.svelte';
import GratitudeMarquee from '../../components/svelte/GratitudeMarquee.svelte';
import { CREDITS, MARQUEE_NAMES } from '../../data/credits';
import pkg from '../../../package.json';
import '../../styles/global.css';

const version = pkg.version;

export const prerender = true;

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang: lang.code === 'en' ? 'en' : lang.code },
  }));
}

const { lang } = Astro.params;
const langCode = (lang ?? 'en') as LangCode;
const t = translations[langCode] ?? translations.en;
const isEn = langCode === 'en';
const docsPath = 'https://docs.primebrick.dev';
const contactHref = isEn ? '/en/contact' : `/${langCode}/contact`;
const homeHref = isEn ? '/en/' : `/${langCode}/`;
const thankyouHref = isEn ? '/en/thank-you' : `/${langCode}/thank-you`;

// Localized section labels for the credits sections.
const sectionLabels: Record<string, string> = {
  weThank: t.thankyou.weThank,
  sectionFoundation: t.thankyou.sectionFoundation,
  sectionFrameworks: t.thankyou.sectionFrameworks,
  sectionBuild: t.thankyou.sectionBuild,
  sectionUi: t.thankyou.sectionUi,
  sectionData: t.thankyou.sectionData,
  sectionAuth: t.thankyou.sectionAuth,
  sectionAi: t.thankyou.sectionAi,
  sectionDocs: t.thankyou.sectionDocs,
  sectionExport: t.thankyou.sectionExport,
  sectionTesting: t.thankyou.sectionTesting,
  sectionUtilities: t.thankyou.sectionUtilities,
  sectionAiAgents: t.thankyou.sectionAiAgents,
};
---

<!doctype html>
<html lang={langCode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.thankyou.subtitle.slice(0, 160)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />
    <title>PrimeBrick — {t.thankyou.title}</title>
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={`https://primebrick.dev${l.code === 'en' ? '/en/thank-you' : `/${l.code}/thank-you`}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://primebrick.dev/en/thank-you" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <!-- Top banner (sticky, non-dismissible) -->
    <TopBanner text={t.banner.text} href={contactHref} />

    <!-- Navigation (sticky, condensing on scroll) -->
    <nav id="site-nav" class="sticky top-9 z-50 border-b border-slate-800/50 bg-slate-950/40 backdrop-blur-sm transition-all duration-300">
      <div id="nav-inner" class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 transition-all duration-300">
        <a href={homeHref} class="flex items-center gap-2 transition-all duration-300" id="nav-logo" aria-label="PrimeBrick home">
          <img src="/logo-full-dark.svg" alt="PrimeBrick" width="170" height="32" class="h-7 w-auto" />
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a href={homeHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.home}</a>
          <a href={docsPath} class="text-slate-300 hover:text-sky-400 transition-colors" target="_blank" rel="noopener">{t.nav.docs}</a>
          <a href={contactHref} class="text-slate-300 hover:text-sky-400 transition-colors">{t.nav.contact}</a>
          <a href={thankyouHref} class="text-sky-400 transition-colors" aria-current="page">{t.nav.thankyou}</a>
          <a
            href="https://opensource.org/license/MIT"
            class="text-slate-300 hover:text-sky-400 transition-colors"
            target="_blank"
            rel="noopener"
          >
            {t.nav.license}
          </a>
          <GitHubDropdown client:load />
          <LanguageSwitcher client:load currentLang={langCode} />
        </div>
      </div>
    </nav>
    <script>
      (() => {
        const nav = document.getElementById('site-nav');
        const inner = document.getElementById('nav-inner');
        const logo = document.getElementById('nav-logo');
        if (!nav || !inner) return;
        const onScroll = () => {
          const scrolled = window.scrollY > 20;
          if (scrolled) {
            inner.classList.replace('py-4', 'py-2');
            nav.classList.add('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.remove('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-xl', 'text-lg');
          } else {
            inner.classList.replace('py-2', 'py-4');
            nav.classList.remove('bg-slate-950/80', 'backdrop-blur-md', 'shadow-lg', 'border-slate-800/80');
            nav.classList.add('bg-slate-950/40', 'border-slate-800/50');
            logo?.classList.replace('text-lg', 'text-xl');
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <!-- Hero -->
    <section class="relative z-10 px-6 pt-24 pb-16 text-center">
      <div class="mx-auto max-w-3xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-700/50 bg-slate-900/50 px-4 py-1.5 text-xs font-medium text-slate-400 backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          {t.thankyou.badge}
        </div>
        <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl">
          <span class="bg-gradient-to-b from-white via-sky-200 to-slate-400 bg-clip-text text-transparent">
            {t.thankyou.title}
          </span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400 sm:text-xl">
          {t.thankyou.subtitle}
        </p>
      </div>
    </section>

    <!-- The Spirit of Open Source -->
    <section class="relative z-10 px-6 py-16">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 flex justify-center">
          <OpenSourceHeart ariaLabel={t.thankyou.heartAria} class="h-14 w-14" />
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          <span class="bg-gradient-to-b from-white to-slate-400 bg-clip-text text-transparent">
            {t.thankyou.spiritTitle}
          </span>
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
          {t.thankyou.spiritText}
        </p>
      </div>
    </section>

    <!-- Scroll-driven credits experience -->
    <ThankYouScroll client:load sections={CREDITS} labels={sectionLabels} />

    <!-- The Soul of Open Source (closing) -->
    <section class="relative z-10 px-6 py-24 text-center">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          <span class="bg-gradient-to-b from-white to-slate-400 bg-clip-text text-transparent">
            {t.thankyou.soulTitle}
          </span>
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
          {t.thankyou.soulText}
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://opensource.org/license/MIT"
            class="rounded-xl border border-slate-700 bg-slate-900/50 px-7 py-3.5 text-sm font-semibold text-slate-200 backdrop-blur-sm transition-all hover:border-sky-500 hover:text-sky-400 hover:scale-105"
            target="_blank"
            rel="noopener"
          >
            {t.thankyou.ctaLicense}
          </a>
          <a
            href="https://github.com/michaelsogos/primebrick-v3-website"
            class="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:bg-sky-400 hover:scale-105"
            target="_blank"
            rel="noopener"
          >
            <GitHubIcon class="h-4 w-4" />
            {t.thankyou.ctaContribute}
          </a>
        </div>
      </div>
    </section>

    <!-- Gratitude marquee -->
    <GratitudeMarquee client:visible names={MARQUEE_NAMES} label={t.thankyou.marqueeLabel} />

    <!-- Footer -->
    <footer class="relative z-10 border-t border-slate-800/50 px-6 py-8">
      <div class="mx-auto flex max-w-7xl items-center justify-between text-sm text-slate-500">
        <span>&copy; 2026 {t.footer.copyright}</span>
        <div class="flex items-center gap-4">
          <span class="text-xs text-slate-600">v{version}</span>
          <a
            href="https://github.com/michaelsogos/primebrick-v3-website"
            class="inline-flex items-center gap-1.5 hover:text-sky-400 transition-colors"
            target="_blank"
            rel="noopener"
          >
            <GitHubIcon class="h-4 w-4" />
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
