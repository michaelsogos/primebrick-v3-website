---
import { LANGUAGES, type LangCode } from '../../i18n/translations';

interface Props {
  lang: LangCode;
  title: string;
  description: string;
  /** Path under /{lang}/ without slashes, e.g. 'contact', 'demo/shell' — '' for lang home */
  pagePath?: string;
  noindex?: boolean;
}

const { lang, title, description, pagePath = '', noindex = false } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site).href;
const hrefSuffix = pagePath ? `${pagePath}/` : '';

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb =
  segments.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: segments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: seg === lang ? 'Home' : seg.replace(/-/g, ' '),
          item: `${site}/${segments.slice(0, i + 1).join('/')}/`,
        })),
      }
    : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PrimeBrick',
    url: 'https://primebrick.dev',
    logo: 'https://primebrick.dev/favicon-512.png',
    sameAs: ['https://github.com/michaelsogos'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'PrimeBrick',
    url: 'https://primebrick.dev',
    inLanguage: LANGUAGES.map((l) => l.hreflang),
  },
  ...(breadcrumb ? [breadcrumb] : []),
];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
<link rel="icon" sizes="any" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon-512.png" />
<title>{title}</title>
{LANGUAGES.map((l) => (
  <link rel="alternate" hreflang={l.hreflang} href={`https://primebrick.dev/${l.code}/${hrefSuffix}`} />
))}
<link rel="alternate" hreflang="x-default" href={`https://primebrick.dev/en/${hrefSuffix}`} />
<link rel="canonical" href={canonical} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
