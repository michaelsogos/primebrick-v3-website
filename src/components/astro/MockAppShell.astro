---
/**
 * MockAppShell.astro — Reusable mock app shell for demo pages.
 *
 * Renders a browser device frame containing:
 *   - A sidebar (slot content, width configurable)
 *   - A topbar (standard Primebrick header with search, AI CTA, tz, lang, buttons)
 *   - A content area (slot content)
 *   - An optional dialog overlay (slot content, positioned above app)
 *
 * Slots:
 *   - "sidebar":  Sidebar content (collapsed rail icons OR expanded nav)
 *   - "content":  Main content area (toolbar, table, etc.)
 *   - "dialog":   Dialog overlay (positioned absolutely above the app body)
 *
 * Props:
 *   - url:               Browser URL bar text
 *   - searchPlaceholder: Topbar search placeholder text
 *   - searchShortcut:    Topbar search shortcut badge (e.g. "Ctrl K")
 *   - sidebarWidth:      CSS width for sidebar (e.g. "56px", "255px", "180px")
 *   - blurred:           When true, applies blur+opacity to content area (for dialog overlay scenes)
 *   - contentId:         Optional ID for the content area element (for scroll engine hooks)
 *   - screenMockId:      Optional ID for the screen-mock element (for scroll engine hooks)
 */
interface Props {
  url?: string;
  searchPlaceholder?: string;
  searchShortcut?: string;
  sidebarWidth?: string;
  blurred?: boolean;
  contentId?: string;
  screenMockId?: string;
}
const {
  url = 'https://backoffice.acme.org/customers',
  searchPlaceholder = 'Search...',
  searchShortcut = 'Ctrl K',
  sidebarWidth,
  blurred = false,
  contentId,
  screenMockId,
} = Astro.props;
---
<div class="screen-mock" id={screenMockId}>
  <div class="browser-bar">
    <div class="browser-dots">
      <span class="browser-dot red"></span>
      <span class="browser-dot yellow"></span>
      <span class="browser-dot green"></span>
    </div>
    <div class="browser-url"><span class="url-lock">🔒</span>{url}</div>
  </div>
  <div class="app-body">
    <!-- Sidebar (slot) -->
    <div class="pb-sidebar" style={sidebarWidth ? `width:${sidebarWidth}` : undefined}>
      <slot name="sidebar" />
    </div>
    <!-- Main area -->
    <div class="pb-main">
      <!-- Topbar -->
      <div class="pb-header">
        <div class="pb-header-left">
          <button class="pb-header-toggle"><i data-icon="panelLeft"></i></button>
          <div class="pb-header-search">
            <i data-icon="search"></i>{searchPlaceholder}
            <span class="kbd">{searchShortcut}</span>
          </div>
          <button class="pb-header-btn pb-ai-cta" title="AI Assistant">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><path d="M6 20a2 2 0 1 1-4 0 2 2 0 0 1 4 0"/></svg>
          </button>
        </div>
        <div class="pb-header-right">
          <div class="pb-header-tz"><i data-icon="globe"></i>Europe/Rome</div>
          <button class="pb-header-lang">IT<i data-icon="chevronDown"></i></button>
          <button class="pb-header-btn" title="Errors"><i data-icon="triangleAlert"></i></button>
          <button class="pb-header-btn" title="Notifications"><i data-icon="bell"></i><span class="btn-badge">3</span></button>
          <button class="pb-header-btn" title="Theme"><i data-icon="moon"></i></button>
        </div>
      </div>
      <!-- Content area (slot) -->
      <div class="pb-content" id={contentId} style={blurred ? 'filter:blur(1px);opacity:0.4' : undefined}>
        <slot name="content" />
      </div>
    </div>
    <!-- Dialog overlay (slot) — positioned above app body -->
    <slot name="dialog" />
  </div>
</div>
